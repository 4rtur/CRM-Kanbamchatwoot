# ======================================
# CRM Kanban — Variáveis de Ambiente
# ======================================
# Copie este arquivo para `.env` e preencha os valores.
# O script `install.sh` gera este arquivo automaticamente.

# --------------------------------------
# BANCO DE DADOS (compartilha Postgres com Chatwoot)
# --------------------------------------
# Usa o container `chatwoot-postgres-1` na rede `chatwoot_default`.
# Database separado (`chatwoot_crm`) é criado automaticamente pelo install.sh.
# DATABASE_URL=postgresql://chatwoot:SENHA@chatwoot-postgres-1:5432/chatwoot_crm

# --------------------------------------
# CHATWOOT
# --------------------------------------
# URL pública do seu Chatwoot (com https://).
# CHATWOOT_URL=https://chat.seudominio.com.br

# Token API do Chatwoot (Profile Settings → Access Token).
# CHATWOOT_API_TOKEN=seu_token_aqui

# ID da conta no Chatwoot (normalmente 1 se for a conta padrão).
# CHATWOOT_ACCOUNT_ID=1

# --------------------------------------
# AUTENTICAÇÃO
# --------------------------------------
# Secret para assinar sessões. Gere com: openssl rand -hex 32
# AUTH_SECRET=

# --------------------------------------
# TENANT PADRÃO (single-tenant MVP)
# --------------------------------------
# DEFAULT_TENANT_ID=default

# --------------------------------------
# CRM — OPCIONAIS
# --------------------------------------
# Porta local exposta pelo container (padrão 3005).
# CRM_PORT=3005

# Senha de acesso único (modo legacy — use AUTH_SECRET quando possível).
# CRM_ACCESS_PASSWORD=

# Feature flag — manter true em produção.
# USE_DATABASE=true
