# Postgres (reusa o do Chatwoot na porta 54329, database separado crm_kanban)
DATABASE_URL=postgres://crm_kanban_user:SENHA_FORTE_AQUI@localhost:54329/crm_kanban

# Chatwoot (credenciais do tenant default, sobrescreve config do usuário final)
CHATWOOT_URL=https://chat.cirurgiaoitech.tech
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=3

# Tenant default (single-tenant MVP — Cirurgião)
DEFAULT_TENANT_ID=cirurgiao

# Feature flags
USE_DATABASE=true
